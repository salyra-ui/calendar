{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "artifacts/angular",
    "rootDir": "packages/calendar/src"
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true
  },
  "include": [
    "packages/calendar/src/angular/**/*.ts",
    "packages/calendar/src/core/**/*.ts"
  ]
}
