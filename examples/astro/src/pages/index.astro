---
import DateTimePicker from "@salyra-ui/date-time-picker/astro/Root.astro";
import Segment from "@salyra-ui/date-time-picker/astro/Segment.astro";
import DateTimeCalendar from "@salyra-ui/date-time-picker/astro/Calendar.astro";
import Root from "../../../../packages/calendar/src/astro/Root.astro";
import Calendar from "../../../../packages/calendar/src/astro/Calendar.astro";
import Action from "../../../../packages/calendar/src/astro/Action.astro";
import "../../../../packages/calendar/src/styles.css";
import "../../../site.css";
const options = {
  selection: "range",
  commit: "explicit",
  referenceDate: "2026-10-03",
  month: { year: 2010, month: 3 },
} as const;
const intervalOptions = {
  selection: "range",
  referenceDate: "2010-03-01",
  month: { year: 2010, month: 3 },
  minDuration: 3600,
  defaultValue: {
    start: { date: "2010-03-09", time: "13:00" },
    end: { date: "2010-03-09", time: "14:00" },
  },
} as const;
---

<html lang="en">
  <head>
    <title>Astro calendar</title>
  </head>
  <body>
    <main style="padding:40px">
      <h1>Astro</h1>
      <Root {options} id="date-editor">
        <Calendar
          {options}
          class="sp-calendar"
          renderOptions={{
            weekdays: {
              6: { label: "Saturday off", class: "saturday" },
              0: { label: "Sunday rest", class: "sunday" },
            },
          }}
        />
        <Action action="apply">Apply</Action>
        <output id="value" data-picker-output></output>
      </Root>
      <section id="dt-editor">
        <DateTimePicker
          options={{
            commit: "explicit",
            referenceDate: "2010-03-09",
            defaultValue: { date: "2010-03-09", time: "09:30" },
          }}
        >
          <label>
            Hours
            <Segment part="hour" />
          </label>
          <label>
            Minutes
            <Segment part="minute" />
          </label>
          <Action action="apply">Apply</Action>
          <output id="dt-value" data-picker-output></output>
        </DateTimePicker>
      </section>
      <section id="astro-duration">
        <h2>One-hour date-time range</h2>
        <DateTimePicker options={intervalOptions}>
          <DateTimeCalendar options={intervalOptions} class="sp-calendar" />
        </DateTimePicker>
      </section>
    </main>
  </body>
</html>
