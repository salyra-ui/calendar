{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/core/**/*.ts",
    "src/react/**/*.tsx",
    "src/vanilla/**/*.ts",
    "src/angular/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "src/vue/**/*.ts",
    "examples/**/*.tsx"
  ]
}
