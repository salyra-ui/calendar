{
  "name": "@salyra-ui/date-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Composable calendars and date, time and date-time pickers",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4330",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:site": "vite build",
    "test:browser": "playwright test",
    "bench": "tsx scripts/bench.ts",
    "check:frameworks": "tsx scripts/check-frameworks.ts && svelte-check --tsconfig ./tsconfig.svelte.json && ngc -p tsconfig.angular.json",
    "test:ssr": "tsx --tsconfig tsconfig.angular.json scripts/ssr.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "dev:astro": "astro dev --root examples/astro --host 127.0.0.1 --port 4331",
    "build:astro": "astro build --root examples/astro"
  },
  "exports": {
    ".": "./src/core/index.ts",
    "./react": "./src/react/index.tsx",
    "./svelte": "./src/svelte/index.ts",
    "./vue": "./src/vue/index.ts",
    "./angular": "./src/angular/index.ts",
    "./vanilla": "./src/vanilla/index.ts",
    "./astro": "./src/vanilla/index.ts",
    "./astro/*": "./src/astro/*",
    "./styles.css": "./src/styles.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/astro/client.*"
  ],
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=5",
    "vue": ">=3.5",
    "@angular/core": ">=20",
    "@angular/common": ">=20",
    "astro": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/common": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "~20.3.33",
    "@angular/compiler": "~20.3.33",
    "@angular/compiler-cli": "~20.3.33",
    "@angular/core": "~20.3.33",
    "@angular/platform-browser": "~20.3.33",
    "@angular/platform-server": "~20.3.33",
    "@astrojs/check": "^0.9.4",
    "@astrojs/compiler": "2.13.1",
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@playwright/test": "^1.50.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/server-renderer": "^3.5.0",
    "astro": "^7.3.5",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rxjs": "^7.8.1",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.0"
  }
}
